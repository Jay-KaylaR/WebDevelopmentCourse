<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Semantic Cards Layout</title>

<style>
/* ================= GLOBAL STYLES ================= */
body {
  font-family: Arial, sans-serif;
  margin: 0;
}

/* ================= HEADER ================= */
header {
  background-color: #456;
  color: white;
  text-align: center;
  padding: 30px;
}

/* Moving header text animation */
.moving-header {
  position: relative; 
  animation: scrollText 10s linear infinite;
  white-space: nowrap; 
  overflow: hidden;
}

@keyframes scrollText {
  0% { transform: translateX(0); }
  100% { transform: translateX(100%); }
}

/* ================= SECTIONS ================= */
section {
  padding: 20px; /* Spacing around content */
}

/* ================= CUSTOM DIV ================= */
.myDiv {
  border: 5px outset red;
  background-color: lightblue;
  text-align: center;
  width: 100%;
}

/* ================= CARDS ================= */
.card-container {
  display: flex;
  flex-wrap: wrap; /* Allows cards to wrap onto next row */
  gap: 20px; /* Space between cards */
}

.card {
  flex-basis: calc(25% - 20px); /* 4 cards per row */
  background-color: #f0f0f0;
  border: 1px solid #ccc;
  text-align: center;
  min-height: 150px;
  border-radius: 5px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.2);
  transition: 0.3s;
}

.card:hover {
  box-shadow: 0 8px 16px rgba(0,0,0,0.2);
}

.container {
  padding: 10px; /* Spacing inside card content */
}

img {
  width: 100%;
  border-radius: 5px 5px 0 0; /* Rounded top corners of images */
}

/* ================= RESPONSIVE CARDS ================= */
@media (max-width: 992px) {
  .card { flex-basis: calc(50% - 20px); } /* 2 cards per row */
}

@media (max-width: 576px) {
  .card { flex-basis: 100%; } /* 1 card per row on small screens */
}

/* ================= FOOTER ================= */
footer {
  background-color: #333;
  color: white;
  text-align: center;
  padding: 10px;
}
</style>
</head>

<body>

<!-- ================= HEADER ================= -->
<header>
  <h1 class="moving-header">My Card Layout</h1>
  <p>Using Semantic HTML</p>
</header>

<main>

  <!-- ================= INTRO SECTION ================= -->
  <section>
    <h2>Introduction</h2>
    <div class="card-container">
      <!-- Using article elements for semantic content boxes -->
      <article class="myDiv">
        <h2>This is a heading</h2>
        <p>This is some text in a semantic article.</p>
      </article>

      <article class="myDiv">
        <h2>This is another heading</h2>
        <p>This is more text inside an article.</p>
      </article>
    </div>
  </section>

  <!-- ================= BASIC TEAM CARDS ================= -->
  <section>
    <h2>Team Members</h2>
    <div class="card-container">
      <article class="card">
        <img src="img_avatar.png" alt="Avatar">
        <div class="container">
          <h4><b>John Doe</b></h4>
          <p>Architect & Engineer</p>
        </div>
      </article>

      <article class="card">
        <img src="img_avatar.png" alt="Avatar">
        <div class="container">
          <h4><b>Jane Doe</b></h4>
          <p>Designer</p>
        </div>
      </article>

      <article class="card">
        <img src="img_avatar.png" alt="Avatar">
        <div class="container">
          <h4><b>Mike Ross</b></h4>
          <p>Developer</p>
        </div>
      </article>
    </div>
  </section>

  <!-- ================= GENERIC CARDS ================= -->
  <section>
    <h2>More Cards</h2>
    <div class="card-container">
      <article class="card">Card 1</article>
      <article class="card">Card 2</article>
      <article class="card">Card 3</article>
      <article class="card">Card 4</article>
      <article class="card">Card 5</article>
      <article class="card">Card 6</article>
    </div>
  </section>

  <!-- ================= FULL PROFILE TEAM CARDS ================= -->
  <section>
    <h2>Team Members</h2>
    <div class="card-container">
      <article class="card">
        <img src="img_avatar.png" alt="John Doe">
        <div class="container">
          <h3>John Doe</h3>
          <p><strong>Role:</strong> Architect & Engineer</p>
          <p><strong>Phone:</strong> +254 712 345 678</p>
          <p><strong>Email:</strong> john@example.com</p>
        </div>
      </article>

      <article class="card">
        <img src="img_avatar.png" alt="Jane Doe">
        <div class="container">
          <h3>Jane Doe</h3>
          <p><strong>Role:</strong> Designer</p>
          <p><strong>Phone:</strong> +254 798 123 456</p>
          <p><strong>Email:</strong> jane@example.com</p>
        </div>
      </article>

      <article class="card">
        <img src="img_avatar.png" alt="Mike Ross">
        <div class="container">
          <h3>Mike Ross</h3>
          <p><strong>Role:</strong> Developer</p>
          <p><strong>Phone:</strong> +254 701 987 654</p>
          <p><strong>Email:</strong> mike@example.com</p>
        </div>
      </article>

      <article class="card">
        <img src="img_avatar.png" alt="Rachel Zane">
        <div class="container">
          <h3>Rachel Zane</h3>
          <p><strong>Role:</strong> Legal Consultant</p>
          <p><strong>Phone:</strong> +254 722 456 789</p>
          <p><strong>Email:</strong> rachel@example.com</p>
        </div>
      </article>
    </div>
  </section>

</main>

<!-- ================= FOOTER ================= -->
<footer>
  <p>© 2026 My Website</p>
</footer>

</body>
</html>
