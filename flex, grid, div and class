<html>
<head>
<style>
.myDiv {
  border: 5px outset red;
  background-color: lightblue;
  text-align: center;
  WIDTH: 33.3%;
  
}
div {
  display: block;
}

.card-container {
  display: grid;
  /* Creates 4 columns of equal width (1fr) */
  grid-template-columns: repeat(4, 1fr); 
  /* Adds space between cards */
  gap: 20px; 
}

.card {
  /* Add styling for your cards (e.g., border, padding, height) */
  background-color: #f0f0f0;
  border: 1px solid #ccc;
  padding: 20px;
  text-align: center;
  /* Ensures all cards have the same height */
  min-height: 150px; 
}

/* Optional: Make it responsive on smaller screens */
@media (max-width: 992px) {
  .card-container {
    grid-template-columns: repeat(2, 1fr); /* 2 cards per row on medium screens */
  }
}s

@media (max-width: 576px) {
  .card-container {
    grid-template-columns: 1fr; /* 1 card per row on small screens */
  }
}


.card-container {
  display: flex;
  flex-wrap: wrap; /* Allows cards to move to the next row */
  gap: 20px; /* Adds space between cards */
}

.card {
  /* Calculates width for 4 cards per row with gap taken into account */
  flex-basis: calc(25% - 20px); 
  /* Add styling for your cards */
  background-color: #f0f0f0;
  border: 1px solid #ccc;
  padding: 20px;
  text-align: center;
  min-height: 150px;
}





.card {
  box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2); /* Adds a subtle shadow */
  transition: 0.3s; /* Smooth transition for hover effects */
  width: 300px; /* Example fixed width, often responsive in practice */
}

.card:hover {
  box-shadow: 0 8px 16px 0 rgba(0,0,0,0.2); /* Shadow deepens on hover */
}

.container {
  padding: 2px 16px; /* Spacing for text content */
}

.card {
  box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
  transition: 0.3s;
  border-radius: 5px; /* 5px rounded corners */
}

/* Add rounded corners to the top left and the top right corner of the image */
img {
  border-radius: 5px 5px 0 0;
}




</style>
</head>
